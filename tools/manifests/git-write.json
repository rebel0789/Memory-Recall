{
  "schemaVersion": "1.0.0",
  "id": "tool:git-write",
  "name": "Create local commits and tags",
  "version": "0.1.0",
  "riskClass": "reversible-write",
  "permissions": {
    "filesystem": {
      "read": [
        ".git",
        "."
      ],
      "write": [
        ".git"
      ]
    },
    "network": []
  },
  "allowedRoles": [
    "agent:release-manager"
  ],
  "inputSchema": {
    "type": "object"
  },
  "outputSchema": {
    "type": "object"
  },
  "timeoutMs": 30000,
  "outputLimitBytes": 1000000,
  "approval": {
    "required": false,
    "binding": "exact-operation-hash"
  }
}
