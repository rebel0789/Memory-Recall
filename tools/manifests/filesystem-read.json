{
  "schemaVersion": "1.0.0",
  "id": "tool:filesystem-read",
  "name": "Read bounded workspace files",
  "version": "0.1.0",
  "riskClass": "read-only",
  "permissions": {
    "filesystem": {
      "read": [
        "."
      ],
      "write": []
    },
    "network": []
  },
  "allowedRoles": [
    "agent:orchestrator",
    "agent:researcher",
    "agent:context-curator",
    "agent:backend-builder",
    "agent:frontend-builder",
    "agent:designer",
    "agent:reviewer",
    "agent:security-auditor",
    "agent:evaluator",
    "agent:release-manager"
  ],
  "inputSchema": {
    "type": "object"
  },
  "outputSchema": {
    "type": "object"
  },
  "timeoutMs": 30000,
  "outputLimitBytes": 1000000,
  "approval": {
    "required": false,
    "binding": "exact-operation-hash"
  }
}
