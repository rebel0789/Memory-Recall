{
  "$id": "https://openagentfabric.dev/schemas/context-pack-use-plan-1.0.json",
  "title": "Context pack use plan",
  "description": "Sanitized harness-facing plan for using an OAF context pack without exposing objective text, launch instructions, markdown content, source content, credentials, endpoints, or local filesystem paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "usePlanVersion",
    "id",
    "workspaceId",
    "generatedAt",
    "targetHarness",
    "sourceHarnesses",
    "contextPack",
    "resource",
    "requestedInputs",
    "requiredLocalReads",
    "coverage",
    "sourceSelection",
    "delivery",
    "sourceGraph",
    "handoffArtifact",
    "safeguards",
    "usePlanFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "usePlanVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "id": { "type": "string", "pattern": "^ctxuse_[a-f0-9]{24}$" },
    "workspaceId": { "type": "string", "pattern": "^ws_[A-Za-z0-9._:-]{1,120}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "targetHarness": { "enum": ["codex", "claude-code", "cursor", "a2a", "generic"] },
    "sourceHarnesses": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["codex", "claude-code", "cursor"] } },
    "contextPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packVersion", "createdAt", "fingerprint", "scannerVersion", "compilerVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^ctxpack_[a-f0-9]{24}$" },
        "packVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "scannerVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "compilerVersion": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "kind"],
      "properties": {
        "uri": { "type": "string", "pattern": "^oaf://workspace/ws_[A-Za-z0-9._:-]{1,120}/context-pack/use-plan/current$" },
        "kind": { "const": "context-pack-use-plan" }
      }
    },
    "recipientProof": { "$ref": "#/$defs/recipientProof" },
    "repository": { "$ref": "#/$defs/repositoryIdentity" },
    "requestedInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceHarnesses", "userSelectedLocators", "changedLocators", "userSelectedCount", "changedLocatorCount"],
      "properties": {
        "sourceHarnesses": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["codex", "claude-code", "cursor"] } },
        "userSelectedLocators": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/locator" } },
        "changedLocators": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/locator" } },
        "userSelectedCount": { "type": "integer", "minimum": 0, "maximum": 16 },
        "changedLocatorCount": { "type": "integer", "minimum": 0, "maximum": 16 }
      }
    },
    "requiredLocalReads": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/readItem" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changedLocators", "graphHints"],
      "properties": {
        "changedLocators": { "$ref": "#/$defs/coverage" },
        "graphHints": { "$ref": "#/$defs/coverage" }
      }
    },
    "sourceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateUnitCount", "selectedUnitCount", "selectedUnitRatio", "estimatedReductionRatio"],
      "properties": {
        "candidateUnitCount": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "selectedUnitCount": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "selectedUnitRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "estimatedReductionRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "deliveredUnitCount", "deliveredByteSize", "deliveredUnitRatio", "observedReductionRatio", "sourceContentUnitCountIncluded", "sourceContentIncluded"],
      "properties": {
        "representation": { "const": "locator-handoff" },
        "deliveredUnitCount": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "deliveredByteSize": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "deliveredUnitRatio": { "type": "number", "minimum": 0, "maximum": 1000 },
        "observedReductionRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "sourceContentUnitCountIncluded": { "const": 0 },
        "sourceContentIncluded": { "const": false }
      }
    },
    "sourceGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceIndexFingerprint", "graphFingerprint", "queryFingerprint", "changedLocators", "representedChangedLocators", "affectedSymbolCount", "omittedAffectedSymbolCount"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "sourceIndexFingerprint": { "type": ["string", "null"], "maxLength": 80 },
        "graphFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "queryFingerprint": { "$ref": "#/$defs/nullableFingerprint" },
        "changedLocators": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/locator" } },
        "representedChangedLocators": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/locator" } },
        "affectedSymbolCount": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "omittedAffectedSymbolCount": { "type": "integer", "minimum": 0, "maximum": 200000 }
      }
    },
    "handoffArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentType", "contentHash", "byteSize", "contentIncluded"],
      "properties": {
        "contentType": { "const": "text/markdown" },
        "contentHash": { "$ref": "#/$defs/nullableFingerprint" },
        "byteSize": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "contentIncluded": { "const": false }
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "canonicalStateMutated",
        "localFilesWritten",
        "externalWritesEnabled",
        "externalAdaptersEnabled",
        "networkCalls",
        "modelCalls",
        "activeMemoryCreated",
        "sourceSnapshotsWritten",
        "objectiveTextIncluded",
        "stepTextIncluded",
        "launchInstructionsIncluded",
        "markdownContentIncluded",
        "sourceContentIncluded",
        "privateContentIncluded",
        "absoluteFilesystemLocationsIncluded",
        "remoteEndpointDetailsIncluded"
      ],
      "properties": {
        "readOnly": { "const": true },
        "canonicalStateMutated": { "const": false },
        "localFilesWritten": { "const": 0 },
        "externalWritesEnabled": { "const": false },
        "externalAdaptersEnabled": { "const": 0 },
        "networkCalls": { "const": 0 },
        "modelCalls": { "const": 0 },
        "activeMemoryCreated": { "const": 0 },
        "sourceSnapshotsWritten": { "const": 0 },
        "objectiveTextIncluded": { "const": false },
        "stepTextIncluded": { "const": false },
        "launchInstructionsIncluded": { "const": false },
        "markdownContentIncluded": { "const": false },
        "sourceContentIncluded": { "const": false },
        "privateContentIncluded": { "const": false },
        "absoluteFilesystemLocationsIncluded": { "const": false },
        "remoteEndpointDetailsIncluded": { "const": false }
      }
    },
    "usePlanFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nullableFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "mcpResourceUri": {
      "type": "string",
      "pattern": "^oaf://workspace/ws_[A-Za-z0-9._:-]{1,120}/context-pack/(use-plan|registry)/current$"
    },
    "recipientProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetHarness", "resourceMode", "requiredResourceUris", "toolsExposed", "externalWritesEnabled", "externalAdaptersEnabled"],
      "properties": {
        "targetHarness": { "enum": ["codex", "claude-code", "cursor", "a2a", "generic"] },
        "resourceMode": { "const": "read-only" },
        "requiredResourceUris": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/mcpResourceUri" }
        },
        "toolsExposed": { "const": 0 },
        "externalWritesEnabled": { "const": false },
        "externalAdaptersEnabled": { "const": 0 }
      }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "generatedAt", "branch", "commitSha", "dirtyCount", "gitStatusAvailable", "source", "reason", "warnings", "safeguards"],
      "properties": {
        "provider": { "const": "git" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "branch": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._/@-]{1,160}$" },
        "commitSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "dirtyCount": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "gitStatusAvailable": { "type": "boolean" },
        "source": { "enum": ["git-status-porcelain", "unavailable"] },
        "reason": { "enum": [null, "not_git_repository", "git_unavailable", "git_status_failed", "git_status_timeout"] },
        "warnings": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "safeguards": {
          "type": "object",
          "additionalProperties": false,
          "required": ["localOnly", "diffBodiesIncluded", "changedPathsIncluded", "absoluteFilesystemLocationsIncluded", "remoteUrlsIncluded"],
          "properties": {
            "localOnly": { "const": true },
            "diffBodiesIncluded": { "const": false },
            "changedPathsIncluded": { "const": false },
            "absoluteFilesystemLocationsIncluded": { "const": false },
            "remoteUrlsIncluded": { "const": false }
          }
        }
      }
    },
    "locator": {
      "type": "string",
      "pattern": "^(workspace|user-selected)://(?!/)(?!\\.\\.(?:/|$))(?!(?:Users|private|\\.git|\\.local|node_modules)(?:/|$))(?!var/folders(?:/|$))(?!.*(?:/\\.\\.(?:/|$)))(?!.*\\\\)(?!.*\\s)(?!.*(?:/(?:Users|private|\\.git|\\.local|node_modules)(?:/|$)))(?!.*(?:/var/folders(?:/|$)))[A-Za-z0-9._~!$&'()*+,;=:@%/\\[\\]-]{1,512}(?:#L[0-9]+-L[0-9]+)?$",
      "maxLength": 640
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "covered", "ratio", "status"],
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "covered": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["covered", "partial", "not_applicable"] }
      }
    },
    "readItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "role", "required", "represented", "contentHash", "reasonCodes", "readHint"],
      "properties": {
        "locator": { "$ref": "#/$defs/locator" },
        "role": { "enum": ["selected_context", "explicit_user_selected", "changed_locator", "source_graph_hint"] },
        "required": { "type": "boolean" },
        "represented": { "type": "boolean" },
        "contentHash": { "$ref": "#/$defs/nullableFingerprint" },
        "reasonCodes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "readHint": { "type": "string", "minLength": 1, "maxLength": 320 }
      }
    }
  }
}
