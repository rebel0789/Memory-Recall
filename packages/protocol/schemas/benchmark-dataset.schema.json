{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/benchmark-dataset.schema.json",
  "title": "Benchmark Truth-Floor Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "suite", "version", "owner", "mergeGate", "sourceRefs", "thresholds", "cases", "createdAt", "labVersion", "datasetFingerprint"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^evalds_[A-Za-z0-9._:-]+$" },
    "suite": { "const": "benchmark-truth-floor" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owner": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "maxLength": 240 },
    "mergeGate": { "const": true },
    "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "labVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "datasetFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEvidenceRecall", "distractorExclusionRate", "selectedTokenRatioMax", "deterministicMismatchCount"],
      "properties": {
        "requiredEvidenceRecall": { "type": "number", "minimum": 0, "maximum": 1 },
        "distractorExclusionRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "selectedTokenRatioMax": { "type": "number", "minimum": 0, "maximum": 1 },
        "deterministicMismatchCount": { "type": "integer", "minimum": 0 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "question", "objective", "step", "expectedAnswer", "abstainWhenMissing", "tokenBudget", "requiredEntities", "requiredEvidenceIds", "distractorIds", "forbiddenIds", "records"],
      "properties": {
        "id": { "type": "string", "pattern": "^evalcase_[A-Za-z0-9._:-]+$" },
        "workspaceId": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1, "maxLength": 240 },
        "objective": { "type": "string", "minLength": 1 },
        "step": { "type": "string", "minLength": 1 },
        "expectedAnswer": { "type": "string", "maxLength": 240 },
        "abstainWhenMissing": { "type": "boolean" },
        "tokenBudget": { "type": "integer", "minimum": 1 },
        "requiredEntities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requiredEvidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" }, "uniqueItems": true },
        "distractorIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" }, "uniqueItems": true },
        "forbiddenIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" }, "uniqueItems": true },
        "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
        "harnessContext": { "$ref": "#/$defs/harnessContext" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "workspaceId", "text", "tags", "relations", "scope", "dataClass", "trustClass", "status", "source", "tokens", "confidence", "authority", "updatedAt", "contentHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "relations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scope": { "enum": ["public", "workspace-private"] },
        "dataClass": { "enum": ["public", "workspace-private", "secret"] },
        "trustClass": { "enum": ["verified", "trusted", "observed", "untrusted"] },
        "status": { "enum": ["active", "verified", "quarantined", "retracted", "expired", "superseded"] },
        "source": { "type": "string", "minLength": 1 },
        "tokens": { "type": "integer", "minimum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "authority": { "type": "number", "minimum": 0, "maximum": 1 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "contentHash": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "harnessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harnesses", "files", "expect"],
      "properties": {
        "harnesses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "objective": { "type": "string" },
        "step": { "type": "string" },
        "tokenBudget": { "type": "integer", "minimum": 1 },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/harnessFile" } },
        "expect": { "$ref": "#/$defs/harnessExpect" }
      }
    },
    "harnessFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "body"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "harnessExpect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedLocators", "excludedLocators", "forbiddenStrings"],
      "properties": {
        "selectedLocators": { "type": "array", "items": { "type": "string", "pattern": "^workspace://[^\\s]+$" }, "uniqueItems": true },
        "excludedLocators": { "type": "array", "items": { "type": "string", "pattern": "^workspace://[^\\s]+$" }, "uniqueItems": true },
        "forbiddenStrings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
