{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/context-selection-result-1.0.json",
  "title": "Context Selection Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "workspaceId", "selectionPolicyVersion", "selectionPolicyFingerprint", "candidateGenerationFingerprint", "totalCandidateCount", "eligibleCandidateCount", "selectedCandidateCount", "selectedTokenCount", "availableTokenBudget", "categoryBudgets", "coverage", "selectedDecisions", "excludedDecisions", "conflicts", "warnings", "sufficiency", "scoreBreakdowns", "bounds", "resultFingerprint"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requestId": { "type": ["string", "null"] },
    "workspaceId": { "type": "string", "minLength": 1 },
    "selectionPolicyVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "selectionPolicyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "candidateGenerationFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "totalCandidateCount": { "type": "integer", "minimum": 0 },
    "eligibleCandidateCount": { "type": "integer", "minimum": 0 },
    "selectedCandidateCount": { "type": "integer", "minimum": 0 },
    "selectedTokenCount": { "type": "integer", "minimum": 0 },
    "availableTokenBudget": { "type": "integer", "minimum": 1 },
    "categoryBudgets": { "$ref": "#/$defs/categoryBudgetSummary" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "selectedDecisions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/decision" } },
    "excludedDecisions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/decision" } },
    "conflicts": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sufficiency": { "$ref": "#/$defs/sufficiency" },
    "scoreBreakdowns": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/scoreBreakdown" } },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairwiseSimilarityComparisons", "selectionIterations"],
      "properties": {
        "pairwiseSimilarityComparisons": { "type": "integer", "minimum": 0 },
        "selectionIterations": { "type": "integer", "minimum": 0 }
      }
    },
    "resultFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "tokens", "category", "utility", "reasonCodes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": ["integer", "null"], "minimum": 1 },
        "tokens": { "type": "integer", "minimum": 0 },
        "category": {
          "type": ["string", "null"],
          "enum": ["governance", "workingState", "decisions", "preferences", "evidence", "procedures", "episodes", "artifacts", "negative", "examples", "other", null]
        },
        "utility": { "type": "number" },
        "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "eligible", "selected", "unresolved"],
      "properties": {
        "requested": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "eligible": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "selected": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "unresolved": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "categoryBudgetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cap", "softReserveRatio", "softReserveTokens", "selectedCount", "selectedTokens"],
      "properties": {
        "cap": { "type": "integer", "minimum": 0, "maximum": 100 },
        "softReserveRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "softReserveTokens": { "type": "integer", "minimum": 0 },
        "selectedCount": { "type": "integer", "minimum": 0 },
        "selectedTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "categoryBudgetSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governance", "workingState", "decisions", "preferences", "evidence", "procedures", "episodes", "artifacts", "negative", "examples", "other"],
      "properties": {
        "governance": { "$ref": "#/$defs/categoryBudgetEntry" },
        "workingState": { "$ref": "#/$defs/categoryBudgetEntry" },
        "decisions": { "$ref": "#/$defs/categoryBudgetEntry" },
        "preferences": { "$ref": "#/$defs/categoryBudgetEntry" },
        "evidence": { "$ref": "#/$defs/categoryBudgetEntry" },
        "procedures": { "$ref": "#/$defs/categoryBudgetEntry" },
        "episodes": { "$ref": "#/$defs/categoryBudgetEntry" },
        "artifacts": { "$ref": "#/$defs/categoryBudgetEntry" },
        "negative": { "$ref": "#/$defs/categoryBudgetEntry" },
        "examples": { "$ref": "#/$defs/categoryBudgetEntry" },
        "other": { "$ref": "#/$defs/categoryBudgetEntry" }
      }
    },
    "sufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requiredIds", "entities", "evidenceCount", "conflictCount"],
      "properties": {
        "state": { "enum": ["sufficient", "insufficient"] },
        "requiredIds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "resolved", "unresolvedCount"],
          "properties": {
            "requested": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "resolved": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "unresolvedCount": { "type": "integer", "minimum": 0 }
          }
        },
        "entities": { "$ref": "#/$defs/coverage" },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "conflictCount": { "type": "integer", "minimum": 0 }
      }
    },
    "scoreBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "fusion", "featureValues", "weightedContributions", "preDiversityUtility", "selectedOrExcluded", "reasonCodes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["governance", "workingState", "decisions", "preferences", "evidence", "procedures", "episodes", "artifacts", "negative", "examples", "other"] },
        "fusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "contributions"],
          "properties": {
            "score": { "type": "number", "minimum": 0 },
            "contributions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceId", "sourceKind", "localRank", "contribution"],
                "properties": {
                  "sourceId": { "type": "string", "minLength": 1 },
                  "sourceKind": { "enum": ["direct", "exact", "lexical", "vector", "graph", "temporal", "preference", "episode"] },
                  "localRank": { "type": "integer", "minimum": 1 },
                  "contribution": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "featureValues": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "weightedContributions": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "preDiversityUtility": { "type": "number" },
        "selectedOrExcluded": { "enum": ["selected", "excluded"] },
        "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
