{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/agent-pack.schema.json",
  "title": "Open Agent Fabric Agent Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "runtime",
    "models",
    "context",
    "memory",
    "capabilities",
    "skills",
    "workflows",
    "permissions",
    "evaluations"
  ],
  "properties": {
    "apiVersion": { "const": "openagentfabric.dev/v1" },
    "kind": { "const": "AgentPack" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "license"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "license": { "type": "string", "minLength": 1 },
        "provenance": { "type": "object" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "localOnly"],
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "localOnly": { "type": "boolean" },
        "minimumVersion": { "type": "string" }
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilities"],
        "properties": {
          "capabilities": { "type": "object" },
          "preferredProvider": { "type": ["string", "null"] },
          "fallbackAllowed": { "type": "boolean", "default": false }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "defaultTokenBudget"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "defaultTokenBudget": { "type": "integer", "minimum": 256 },
        "recordManifest": { "const": true }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "writePolicy"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "writePolicy": { "enum": ["disabled", "propose", "user-confirmed"] },
        "retentionPolicy": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/versionedReference" },
      "uniqueItems": true
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/versionedReference" },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataClasses", "network", "filesystem", "consequentialWrites"],
      "properties": {
        "dataClasses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "network": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "filesystem": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "consequentialWrites": { "type": "boolean" }
      }
    },
    "evaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/versionedReference" },
      "uniqueItems": true
    },
    "ui": { "type": "object" }
  },
  "$defs": {
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "default": true }
      }
    }
  }
}
