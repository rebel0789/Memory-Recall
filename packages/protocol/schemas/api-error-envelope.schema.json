{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/api-error-envelope-1.0.json",
  "title": "API Error Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "error"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "correlationId"],
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "request_validation_failed",
            "invalid_path_parameter",
            "route_not_found",
            "method_not_allowed",
            "request_too_large",
            "unsupported_media_type",
            "unsupported_content_encoding",
            "authentication_required",
            "invalid_credentials",
            "invalid_authentication",
            "csrf_failed",
            "forbidden",
            "resource_not_found",
            "already_bootstrapped",
            "workspace_context_conflict",
            "rate_limited",
            "bootstrap_required",
            "internal_error"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 },
        "correlationId": { "type": "string", "pattern": "^req_[A-Za-z0-9._:-]{8,96}$", "maxLength": 100 },
        "issues": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "code"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 256 },
              "code": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        }
      }
    }
  }
}
