{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/policy-capability-request.schema.json",
  "title": "Policy Capability Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["toolId", "operation", "sideEffectClass", "filesystem", "network", "secretReferences", "dataClasses", "sandbox", "limits"],
  "properties": {
    "toolId": { "type": "string", "pattern": "^tool:[a-z0-9_.:-]{1,120}$", "maxLength": 128 },
    "operation": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sideEffectClass": { "enum": ["read-only", "reversible-write", "consequential-write"] },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "write": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    "network": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol", "host", "port", "methods", "consequence", "locality"],
        "properties": {
          "protocol": { "enum": ["http", "https"] },
          "host": { "type": "string", "minLength": 1, "maxLength": 253 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "methods": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] } },
          "consequence": { "enum": ["read", "write"] },
          "locality": { "enum": ["loopback", "external"] }
        }
      }
    },
    "secretReferences": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^secret:[A-Za-z0-9_.:-]{1,120}$", "maxLength": 128 } },
    "dataClasses": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["public", "workspace-private", "confidential", "secret"] } },
    "sandbox": { "type": "string", "minLength": 1, "maxLength": 80 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "memoryBytes": { "type": "integer", "minimum": 0 },
        "outputBytes": { "type": "integer", "minimum": 0 },
        "inputBytes": { "type": "integer", "minimum": 0 },
        "invocationCount": { "type": "integer", "minimum": 0 },
        "costUnits": { "type": "number", "minimum": 0 },
        "retryCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
