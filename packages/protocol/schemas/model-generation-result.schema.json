{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/model-generation-result.schema.json",
  "title": "Safe Model Generation Result Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gatewayVersion",
    "requestId",
    "correlationId",
    "provider",
    "model",
    "contextManifest",
    "outputFingerprint",
    "validation",
    "repair",
    "usage"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "gatewayVersion": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "pattern": "^provider:native:model:[a-z0-9-]+$" },
    "model": { "type": "string", "minLength": 1 },
    "contextManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifestFingerprint",
        "assemblyFingerprint",
        "compilerVersion",
        "assemblyPolicyVersion",
        "assemblyPolicyFingerprint",
        "selectedCount",
        "excludedCount"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ctx_" },
        "manifestFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "assemblyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "compilerVersion": { "type": "string", "minLength": 1 },
        "assemblyPolicyVersion": { "type": "string", "minLength": 1 },
        "assemblyPolicyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "selectedCount": { "type": "integer", "minimum": 0 },
        "excludedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "outputFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errorCode"],
      "properties": {
        "valid": { "type": "boolean" },
        "errorCode": { "type": ["string", "null"] }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "durationMs"],
      "properties": {
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "occurredAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
