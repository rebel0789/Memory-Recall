{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/durable-workflow-history-1.0.json",
  "title": "Durable Workflow History",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "runId", "events"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workspaceId": { "type": "string", "pattern": "^ws_" },
    "runId": { "type": "string", "pattern": "^run_" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["schemaVersion", "id", "workspaceId", "runId", "type", "sequence", "payload"],
        "properties": {
          "schemaVersion": { "const": "1.0.0" },
          "id": { "type": "string", "pattern": "^evt_" },
          "workspaceId": { "type": "string", "pattern": "^ws_" },
          "runId": { "type": "string", "pattern": "^run_" },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$" },
          "sequence": { "type": "integer", "minimum": 0 },
          "payload": { "type": "object" }
        }
      }
    }
  }
}
