{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/tool-catalog-1.0.json",
  "title": "Reviewed Tool Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolId", "manifestPath", "sha256", "enabled", "handlerBindingId", "reviewStatus", "reviewVersion"],
        "properties": {
          "toolId": { "type": "string", "pattern": "^tool:[a-z0-9_.:-]{1,120}$" },
          "manifestPath": { "type": "string", "minLength": 1, "maxLength": 300 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "enabled": { "type": "boolean" },
          "handlerBindingId": { "type": "string", "pattern": "^handler:" },
          "reviewStatus": { "enum": ["reviewed", "disabled"] },
          "reviewVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
          "disabledReason": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
