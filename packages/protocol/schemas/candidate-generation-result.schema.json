{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/candidate-generation-result-1.0.json",
  "title": "Candidate Generation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "workspaceId", "status", "candidates", "reports", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requestId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "status": { "enum": ["succeeded"] },
    "candidates": { "type": "array", "minItems": 0, "maxItems": 200, "items": { "type": "object" } },
    "reports": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "object" } },
    "warnings": {
      "type": "array",
      "items": { "enum": ["candidate_source_failed", "candidate_source_unavailable", "candidate_source_denied", "candidate_source_timed_out", "candidate_source_cancelled"] },
      "uniqueItems": true
    }
  }
}
