{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/tool-invocation-result-1.0.json",
  "title": "Tool Invocation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "correlationId", "workspaceId", "runId", "stepId", "toolId", "operation", "grantId", "status", "output"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "invocationId": { "type": "string", "pattern": "^toolinv_" },
    "requestId": { "type": ["string", "null"] },
    "correlationId": { "type": ["string", "null"] },
    "workspaceId": { "type": ["string", "null"] },
    "runId": { "type": ["string", "null"] },
    "stepId": { "type": ["string", "null"] },
    "toolId": { "type": ["string", "null"] },
    "toolVersion": { "type": "string" },
    "manifestFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "operation": { "type": ["string", "null"] },
    "grantId": { "type": ["string", "null"] },
    "policyDecisionId": { "type": "string" },
    "policyVersion": { "type": "string" },
    "policyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outputFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["completed", "denied", "failed"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "reconciliation": { "enum": ["not-required", "effect-boundary"] },
    "error": { "type": "object" },
    "output": { "type": ["object", "null"] }
  }
}
