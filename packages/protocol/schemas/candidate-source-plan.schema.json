{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/candidate-source-plan-1.0.json",
  "title": "Candidate Source Plan",
  "type": "array",
  "minItems": 1,
  "maxItems": 16,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["kind", "required"],
    "properties": {
      "kind": {
        "enum": ["exact", "lexical", "vector", "graph", "temporal", "preference", "episode"]
      },
      "sourceId": {
        "type": ["string", "null"],
        "pattern": "^provider:native:context-candidate:[a-z0-9-]+$"
      },
      "required": { "type": "boolean" },
      "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
      "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 }
    }
  }
}
