{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "role",
    "allowedTools",
    "allowedSkills",
    "defaultContextPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedSkills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultContextPolicy": {
      "type": "object"
    },
    "completionCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
