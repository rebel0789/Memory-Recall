{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/context-selection-decision-1.0.json",
  "title": "Context Selection Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "order", "tokens", "category", "utility", "reasonCodes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "order": { "type": ["integer", "null"], "minimum": 1 },
    "tokens": { "type": "integer", "minimum": 0 },
    "category": {
      "type": ["string", "null"],
      "enum": ["governance", "workingState", "decisions", "preferences", "evidence", "procedures", "episodes", "artifacts", "negative", "examples", "other", null]
    },
    "utility": { "type": "number" },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
