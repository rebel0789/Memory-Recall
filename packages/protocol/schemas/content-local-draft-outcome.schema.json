{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/content-local-draft-outcome-1.0.json",
  "title": "Content Local Draft Outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "actorId", "generatedAt", "approval", "draft", "verification", "outcome", "safeguards"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "approval": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "id", "workspaceId", "actorId", "status", "approved", "decidedAt", "sideEffectClass", "operationFingerprint", "candidate", "preview", "binding", "publisher", "reasonCodes"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": { "type": "string", "pattern": "^app_[a-f0-9]{32}$" },
        "workspaceId": { "type": "string" },
        "actorId": { "type": "string" },
        "status": { "enum": ["approved", "rejected", "expired", "cancelled"] },
        "approved": { "type": "boolean" },
        "decidedAt": { "type": "string", "format": "date-time" },
        "sideEffectClass": { "const": "local-only" },
        "operationFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "rank", "angle", "hook", "evidenceIds"],
          "properties": {
            "id": { "type": "string", "pattern": "^cand_[a-f0-9]{32}$" },
            "rank": { "type": "integer", "minimum": 1 },
            "angle": { "type": "string", "minLength": 1 },
            "hook": { "type": "string", "minLength": 1 },
            "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "editableText", "previewFingerprint"],
          "properties": {
            "format": { "const": "plain-text" },
            "editableText": { "type": "string", "minLength": 1 },
            "previewFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": true,
          "required": ["candidateId", "candidateRank", "candidateFingerprint", "evidenceIds", "evidenceFingerprint", "contextManifest", "promptVersion", "outputSchemaName", "outputSchemaVersion"],
          "properties": {
            "candidateId": { "type": "string" },
            "candidateRank": { "type": "integer" },
            "candidateFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "evidenceIds": { "type": "array", "items": { "type": "string" } },
            "evidenceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "contextManifest": {
              "type": "object",
              "additionalProperties": true,
              "required": ["id", "manifestFingerprint"],
              "properties": {
                "id": { "type": "string" },
                "manifestFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            },
            "promptVersion": { "type": "string" },
            "outputSchemaName": { "type": "string" },
            "outputSchemaVersion": { "type": "string" }
          }
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "reason"],
          "properties": {
            "enabled": { "const": false },
            "reason": { "const": "publisher_disabled" }
          }
        },
        "reasonCodes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "id", "workspaceId", "actorId", "approvalId", "candidateId", "status", "format", "editedText", "draftFingerprint", "evidenceIds", "createdAt", "editDistance", "binding", "publisher", "sideEffectClass"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": { "type": "string", "pattern": "^draft_[a-f0-9]{32}$" },
        "workspaceId": { "type": "string" },
        "actorId": { "type": "string" },
        "approvalId": { "type": "string" },
        "candidateId": { "type": "string" },
        "status": { "const": "local-draft" },
        "format": { "const": "plain-text" },
        "editedText": { "type": "string", "minLength": 1 },
        "draftFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "editDistance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "distance", "ratio"],
          "properties": {
            "source": { "const": "approval_preview_to_edited_draft" },
            "distance": { "type": "integer", "minimum": 0 },
            "ratio": { "type": "number", "minimum": 0 }
          }
        },
        "binding": { "type": "object" },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "reason"],
          "properties": {
            "enabled": { "const": false },
            "reason": { "const": "publisher_disabled" }
          }
        },
        "sideEffectClass": { "const": "local-only" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "draftId", "verifiedAt", "valid", "citations", "similarity", "publisher", "reasonCodes"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "draftId": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "valid": { "type": "boolean" },
        "citations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "evidenceIds", "missingEvidenceIds"],
          "properties": {
            "valid": { "type": "boolean" },
            "evidenceIds": { "type": "array", "items": { "type": "string" } },
            "missingEvidenceIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "similarity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxScore", "nearestEvidenceId", "copyingRisk"],
          "properties": {
            "maxScore": { "type": "number", "minimum": 0, "maximum": 1 },
            "nearestEvidenceId": { "type": ["string", "null"] },
            "copyingRisk": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "reasonCodes"],
              "properties": {
                "level": { "enum": ["low", "medium", "high"] },
                "reasonCodes": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "reason"],
          "properties": {
            "enabled": { "const": false },
            "reason": { "const": "publisher_disabled" }
          }
        },
        "reasonCodes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "id", "workspaceId", "actorId", "draftId", "approvalId", "objective", "objectiveMetric", "observedAt", "verification", "editDistance", "causalClaim", "sideEffectClass", "publisher", "reasonCodes"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": { "type": "string", "pattern": "^out_[a-f0-9]{32}$" },
        "workspaceId": { "type": "string" },
        "actorId": { "type": "string" },
        "draftId": { "type": "string" },
        "approvalId": { "type": "string" },
        "objective": { "type": "string", "minLength": 1 },
        "objectiveMetric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value", "direction", "unit"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "value": {},
            "direction": { "enum": ["positive", "negative", "neutral"] },
            "unit": { "type": ["string", "null"] }
          }
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "verification": { "type": "object" },
        "editDistance": { "type": "object" },
        "causalClaim": { "const": "none" },
        "sideEffectClass": { "const": "local-only" },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "reason"],
          "properties": {
            "enabled": { "const": false },
            "reason": { "const": "publisher_disabled" }
          }
        },
        "reasonCodes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localDraftOnly", "publisherEnabled", "externalWrites", "causalClaim", "rawSourceTextExcludedFromVerification"],
      "properties": {
        "localDraftOnly": { "const": true },
        "publisherEnabled": { "const": false },
        "externalWrites": { "const": false },
        "causalClaim": { "const": "none" },
        "rawSourceTextExcludedFromVerification": { "const": true }
      }
    }
  }
}
