{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/context-manifest-1.0.json",
  "title": "Context Manifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "representationTier": {
      "enum": [
        "full",
        "snippet",
        "outline",
        "locator-only",
        "excluded"
      ]
    },
    "representationHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "reasonCodes"
      ],
      "properties": {
        "tier": {
          "$ref": "#/$defs/representationTier"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_:-]*$"
          }
        }
      }
    },
    "sha256Ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contextView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "contentKind",
        "originalContentHash",
        "viewContentHash",
        "originalTokens",
        "viewTokens",
        "reductionRatio",
        "recoverableBy",
        "reasonCodes"
      ],
      "properties": {
        "algorithm": {
          "const": "oaf_context_view_v1"
        },
        "contentKind": {
          "enum": [
            "json",
            "log",
            "code",
            "markdown",
            "text"
          ]
        },
        "originalContentHash": {
          "$ref": "#/$defs/sha256Ref"
        },
        "viewContentHash": {
          "$ref": "#/$defs/sha256Ref"
        },
        "originalTokens": {
          "type": "integer",
          "minimum": 1
        },
        "viewTokens": {
          "type": "integer",
          "minimum": 1
        },
        "reductionRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recoverableBy": {
          "enum": [
            "originalContentHash",
            "manual_review"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_:-]*$"
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "workspaceId",
    "compilerVersion",
    "createdAt",
    "budget",
    "selected",
    "excluded",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^ctx_"
    },
    "workspaceId": {
      "type": "string"
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "compilerVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "manifestFingerprint": {
      "$ref": "#/$defs/sha256Ref"
    },
    "etag": {
      "$ref": "#/$defs/sha256Ref"
    },
    "deltaFrom": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "manifestId",
        "etag",
        "manifestFingerprint",
        "assemblyFingerprint",
        "unchangedRecordIds",
        "addedRecordIds",
        "removedRecordIds",
        "changedRecordIds",
        "assemblyChanged"
      ],
      "properties": {
        "manifestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "etag": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "manifestFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "assemblyFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "unchangedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "addedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assemblyChanged": {
          "type": "boolean"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "used"
      ],
      "properties": {
        "available": {
          "type": "integer",
          "minimum": 1
        },
        "used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "tokens",
          "score",
          "reasonCodes",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": "number"
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "enum": [
              "governance",
              "workingState",
              "decisions",
              "preferences",
              "evidence",
              "procedures",
              "episodes",
              "artifacts",
              "negative",
              "examples",
              "other"
            ]
          },
          "text": {
            "type": "string"
          },
          "contentHash": {
            "$ref": "#/$defs/sha256Ref"
          },
          "representationHint": {
            "$ref": "#/$defs/representationHint"
          },
          "contextView": {
            "$ref": "#/$defs/contextView"
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "tokens",
          "score",
          "reasonCodes",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": "number"
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "category": {
            "enum": [
              "governance",
              "workingState",
              "decisions",
              "preferences",
              "evidence",
              "procedures",
              "episodes",
              "artifacts",
              "negative",
              "examples",
              "other"
            ]
          },
          "text": {
            "type": "string"
          },
          "contentHash": {
            "$ref": "#/$defs/sha256Ref"
          },
          "representationHint": {
            "$ref": "#/$defs/representationHint"
          },
          "contextView": {
            "$ref": "#/$defs/contextView"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assemblyPolicyVersion",
        "assemblyPolicyFingerprint",
        "sectionOrder",
        "selectedRecordIds",
        "totalTokens",
        "sections",
        "assemblyFingerprint"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "assemblyPolicyVersion": {
          "type": "string"
        },
        "assemblyPolicyFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sectionOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "representationTiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/representationTier"
          }
        },
        "selectedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "originalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "recordCount",
              "tokenCount",
              "recordIds",
              "items"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "recordCount": {
                "type": "integer",
                "minimum": 0
              },
              "tokenCount": {
                "type": "integer",
                "minimum": 0
              },
              "recordIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "kind",
                    "tokens",
                    "source",
                    "text",
                    "contentHash"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "tokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "originalTokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "source": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "representation": {
                      "$ref": "#/$defs/representationHint"
                    },
                    "contentHash": {
                      "$ref": "#/$defs/sha256Ref"
                    },
                    "representationHash": {
                      "$ref": "#/$defs/sha256Ref"
                    }
                  }
                }
              }
            }
          }
        },
        "assemblyFingerprint": {
          "$ref": "#/$defs/sha256Ref"
        }
      }
    },
    "selectionSummary": {
      "type": [
        "object",
        "null"
      ]
    },
    "selectionPolicy": {
      "type": [
        "object",
        "null"
      ]
    },
    "candidateGeneration": {
      "type": "object"
    },
    "tokenAccounting": {
      "type": "object"
    },
    "fingerprintAlgorithm": {
      "type": "string"
    },
    "persisted": {
      "type": "boolean"
    },
    "manifestVerification": {
      "type": "object"
    }
  }
}
