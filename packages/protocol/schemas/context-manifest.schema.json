{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/context-manifest-1.0.json",
  "title": "Context Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "workspaceId",
    "compilerVersion",
    "createdAt",
    "budget",
    "selected",
    "excluded",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^ctx_"
    },
    "workspaceId": {
      "type": "string"
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "compilerVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "manifestFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "used"
      ],
      "properties": {
        "available": {
          "type": "integer",
          "minimum": 1
        },
        "used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "tokens",
          "score",
          "reasonCodes",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": "number"
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "enum": [
              "governance",
              "workingState",
              "decisions",
              "preferences",
              "evidence",
              "procedures",
              "episodes",
              "artifacts",
              "negative",
              "examples",
              "other"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "tokens",
          "score",
          "reasonCodes",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": "number"
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "category": {
            "enum": [
              "governance",
              "workingState",
              "decisions",
              "preferences",
              "evidence",
              "procedures",
              "episodes",
              "artifacts",
              "negative",
              "examples",
              "other"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assemblyPolicyVersion",
        "assemblyPolicyFingerprint",
        "sectionOrder",
        "selectedRecordIds",
        "totalTokens",
        "sections",
        "assemblyFingerprint"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "assemblyPolicyVersion": {
          "type": "string"
        },
        "assemblyPolicyFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sectionOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selectedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "recordCount",
              "tokenCount",
              "recordIds",
              "items"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "recordCount": {
                "type": "integer",
                "minimum": 0
              },
              "tokenCount": {
                "type": "integer",
                "minimum": 0
              },
              "recordIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "kind",
                    "tokens",
                    "source",
                    "text",
                    "contentHash"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "tokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "source": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "contentHash": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        },
        "assemblyFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "selectionSummary": {
      "type": [
        "object",
        "null"
      ]
    },
    "selectionPolicy": {
      "type": [
        "object",
        "null"
      ]
    },
    "candidateGeneration": {
      "type": "object"
    },
    "tokenAccounting": {
      "type": "object"
    },
    "fingerprintAlgorithm": {
      "type": "string"
    },
    "persisted": {
      "type": "boolean"
    },
    "manifestVerification": {
      "type": "object"
    }
  }
}
