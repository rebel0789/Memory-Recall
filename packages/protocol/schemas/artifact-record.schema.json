{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/artifact-record-1.0.json",
  "title": "Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "provider",
    "workspaceId",
    "kind",
    "hashAlgorithm",
    "contentHash",
    "hash",
    "byteSize",
    "size",
    "mediaType",
    "filename",
    "dataClass",
    "retention",
    "source",
    "createdAt",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^art_[A-Za-z0-9._-]{16,128}$", "maxLength": 132 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspaceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "maxLength": 128 },
    "kind": { "const": "artifact" },
    "hashAlgorithm": { "const": "sha256" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "byteSize": { "type": "integer", "minimum": 0 },
    "size": { "type": "integer", "minimum": 0 },
    "mediaType": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}$", "maxLength": 127 },
    "filename": { "type": ["string", "null"], "maxLength": 255 },
    "dataClass": { "enum": ["public", "workspace-private", "sensitive"] },
    "retention": { "$ref": "#/$defs/retention" },
    "source": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "createdAt": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["workspace-default", "retain", "expire-at", "legal-hold"] },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
