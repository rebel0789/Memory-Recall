{
  "$id": "https://open-agent-fabric.dev/schemas/loop-observation-1.0.json",
  "title": "Loop observation",
  "description": "Sanitized record of running the validation commands declared by a Loop Plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "id",
    "workspaceId",
    "runId",
    "createdAt",
    "loopPlanId",
    "loopPlanFingerprint",
    "status",
    "commands",
    "events",
    "safeguards",
    "observationFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "command": { "const": "loop observe" },
    "id": { "type": "string", "pattern": "^loopobs_[a-f0-9]{24}$" },
    "workspaceId": { "type": "string", "pattern": "^ws_[A-Za-z0-9._:-]{1,120}$" },
    "runId": { "type": "string", "pattern": "^run_[A-Za-z0-9._:-]{1,120}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "loopPlanId": { "type": "string", "pattern": "^loopplan_[a-f0-9]{24}$" },
    "loopPlanFingerprint": { "$ref": "#/$defs/hash" },
    "status": { "enum": ["passed", "failed"] },
    "commands": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/commandResult" } },
    "events": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/eventRef" } },
    "safeguards": { "$ref": "#/$defs/safeguards" },
    "observationFingerprint": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exitCode", "durationMs", "passed", "outputSummary", "outputHash", "outputTruncated"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 400 },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "passed": { "type": "boolean" },
        "outputSummary": { "type": "string", "maxLength": 320 },
        "outputHash": { "$ref": "#/$defs/hash" },
        "outputTruncated": { "type": "boolean" }
      }
    },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sequence"],
      "properties": {
        "id": { "type": "string", "pattern": "^evt_" },
        "type": { "const": "loop.observation_recorded" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandsLimitedToPlan",
        "rawOutputIncluded",
        "outputSummaryMaxChars",
        "localFilesWrittenOutsideLedger",
        "networkCallsDeclared",
        "modelCalls",
        "externalWritesEnabled",
        "activeMemoryCreated"
      ],
      "properties": {
        "commandsLimitedToPlan": { "const": true },
        "rawOutputIncluded": { "const": false },
        "outputSummaryMaxChars": { "const": 320 },
        "localFilesWrittenOutsideLedger": { "const": 0 },
        "networkCallsDeclared": { "const": 0 },
        "modelCalls": { "const": 0 },
        "externalWritesEnabled": { "const": false },
        "activeMemoryCreated": { "const": 0 }
      }
    }
  }
}
