{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/source-graph-preview.schema.json",
  "title": "Native Source Graph Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "previewVersion", "workspaceId", "generatedAt", "graph", "search", "trace", "impact", "measurements", "safeguards"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "previewVersion": { "const": "oaf-source-graph-preview-1.0.0" },
    "workspaceId": { "$ref": "#/$defs/workspaceId" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "graph": { "$ref": "#/$defs/compactGraph" },
    "search": { "$ref": "#/$defs/searchResult" },
    "trace": { "$ref": "#/$defs/traceResult" },
    "impact": { "$ref": "#/$defs/impactResult" },
    "orientation": { "$ref": "#/$defs/orientation" },
    "focus": { "$ref": "#/$defs/focus" },
    "measurements": { "$ref": "#/$defs/measurements" },
    "safeguards": { "$ref": "#/$defs/safeguards" }
  },
  "$defs": {
    "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$", "maxLength": 128 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nodeId": { "type": "string", "pattern": "^sgnode_[a-f0-9]{32}$" },
    "edgeId": { "type": "string", "pattern": "^sgedge_[a-f0-9]{32}$" },
    "locator": { "type": "string", "pattern": "^workspace://(?!/)(?![^/]*%)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!.*%(?:2[eEfF]|3[aA]|5[cC]|25))[A-Za-z0-9._~!$&'()*+,;=@%/\\[\\]-]{1,512}(?:#L[0-9]+-L[0-9]+)?$" },
    "safeLabel": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?=.{1,240}$)(?!/)(?![A-Za-z]:[\\\\/])(?!.*[?{}=;\\\\])(?!.*[Ss][Ee][Nn][Tt][Ii][Nn][Ee][Ll])(?:[A-Za-z0-9_$@~./#*+,\\[\\]-]+|node:[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*|local:absolute-import)(?: (?:contains|defined_in|imports|exports|references|calls)(?: (?:[A-Za-z0-9_$@~./#*+,\\[\\]-]+|node:[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*|local:absolute-import)){1,2})?$" },
    "nodeKind": { "enum": ["file", "chunk", "symbol", "module"] },
    "edgeKind": { "enum": ["contains", "defined_in", "imports", "exports", "references", "calls"] },
    "sourceRef": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(symbol|astchunk|import|export|call|ref|srcsnap)_[a-f0-9]{16,32}$|^sha256:[a-f0-9]{64}$" },
    "nodeCountMap": {
      "type": "object",
      "maxProperties": 4,
      "additionalProperties": false,
      "properties": {
        "file": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "chunk": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "symbol": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "module": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "edgeCountMap": {
      "type": "object",
      "maxProperties": 6,
      "additionalProperties": false,
      "properties": {
        "contains": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "defined_in": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "imports": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "exports": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "calls": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "references": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "groupPrefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._~!$&'()*+,;=@%\\[\\]-]+(?:/[A-Za-z0-9._~!$&'()*+,;=@%\\[\\]-]+){0,2}$"
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "relations"],
      "properties": {
        "groups": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/orientationGroup" } },
        "relations": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/orientationRelation" } }
      }
    },
    "orientationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prefix", "fileCount", "symbolCount", "changedFileCount", "entryPoints"],
      "properties": {
        "id": { "type": "string", "pattern": "^sggroup_[a-f0-9]{24}$" },
        "prefix": { "$ref": "#/$defs/groupPrefix" },
        "fileCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "symbolCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "changedFileCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "entryPoints": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/nodeReference" } }
      }
    },
    "orientationRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceGroupId", "targetGroupId", "sourcePrefix", "targetPrefix", "count", "edgeKindCounts"],
      "properties": {
        "id": { "type": "string", "pattern": "^sgrelation_[a-f0-9]{24}$" },
        "sourceGroupId": { "type": "string", "pattern": "^sggroup_[a-f0-9]{24}$" },
        "targetGroupId": { "type": "string", "pattern": "^sggroup_[a-f0-9]{24}$" },
        "sourcePrefix": { "$ref": "#/$defs/groupPrefix" },
        "targetPrefix": { "$ref": "#/$defs/groupPrefix" },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "edgeKindCounts": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 2,
          "properties": {
            "imports": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
            "calls": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
          }
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeLimit", "edgeLimit", "nodes", "edges", "omittedNodes", "omittedEdges"],
      "properties": {
        "nodeLimit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "edgeLimit": { "type": "integer", "minimum": 1, "maximum": 400 },
        "nodes": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "maxItems": 400, "items": { "$ref": "#/$defs/edge" } },
        "omittedNodes": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "omittedEdges": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "symbolCount", "moduleCount", "nodeCount", "edgeCount", "nodeKindCounts", "edgeKindCounts", "hotspots", "entryPoints"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 0 },
        "symbolCount": { "type": "integer", "minimum": 0 },
        "moduleCount": { "type": "integer", "minimum": 0 },
        "nodeCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "qualifiedSymbolCount": { "type": "integer", "minimum": 0 },
        "ambiguousSymbolLabelCount": { "type": "integer", "minimum": 0 },
        "ambiguousLabels": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/ambiguousLabel" } },
        "nodeKindCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "edgeKindCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "hotspots": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/hotspot" } },
        "entryPoints": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/nodeReference" } },
        "deprioritized": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/nodeReference" } }
      }
    },
    "ambiguousLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "count", "locators"],
      "properties": {
        "label": { "$ref": "#/$defs/safeLabel" },
        "count": { "type": "integer", "minimum": 2 },
        "qualifiedLabels": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/safeLabel" } },
        "locators": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/locator" } }
      }
    },
    "compactGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "workspaceId", "graphVersion", "parserVersion", "builtAt", "sourceIndexFingerprint", "graphFingerprint", "summary", "diagnostics", "sampleLimit", "sampleNodes", "sampleEdges", "omittedNodes", "omittedEdges"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "workspaceId": { "$ref": "#/$defs/workspaceId" },
        "graphVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "parserVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "builtAt": { "type": "string", "format": "date-time" },
        "sourceIndexFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "summary": { "$ref": "#/$defs/summary" },
        "diagnostics": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/diagnostic" } },
        "sampleLimit": { "type": "integer", "minimum": 1, "maximum": 50 },
        "sampleNodes": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/node" } },
        "sampleEdges": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/edge" } },
        "omittedNodes": { "type": "integer", "minimum": 0 },
        "omittedEdges": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "workspaceId": { "$ref": "#/$defs/workspaceId" },
        "kind": { "$ref": "#/$defs/nodeKind" },
        "label": { "$ref": "#/$defs/safeLabel" },
        "qualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "locator": { "$ref": "#/$defs/locator" },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "symbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "scopeChain": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/safeLabel" } },
        "moduleHash": { "$ref": "#/$defs/fingerprint" },
        "contentHash": { "$ref": "#/$defs/fingerprint" },
        "sourceSnapshotId": { "type": "string", "pattern": "^srcsnap_[a-f0-9]{16}$" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "kind", "fromNodeId", "toNodeId", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/edgeId" },
        "workspaceId": { "$ref": "#/$defs/workspaceId" },
        "kind": { "$ref": "#/$defs/edgeKind" },
        "fromNodeId": { "$ref": "#/$defs/nodeId" },
        "toNodeId": { "$ref": "#/$defs/nodeId" },
        "locator": { "$ref": "#/$defs/locator" },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "exportName": { "$ref": "#/$defs/safeLabel" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "inbound", "outbound", "total"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "label": { "$ref": "#/$defs/safeLabel" },
        "qualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "locator": { "$ref": "#/$defs/locator" },
        "symbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "inbound": { "type": "integer", "minimum": 0 },
        "outbound": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "reasonCodes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "nodeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "locator", "symbolKind"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "label": { "$ref": "#/$defs/safeLabel" },
        "qualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "locator": { "$ref": "#/$defs/locator" },
        "symbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "reasonCodes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "representedFileCount", "representedJsTsLocators", "skippedFileCount", "skippedLocators", "oversizedFileCount", "oversizedLocators", "unsupportedFileCount", "unsupportedExtensions", "maxFilesReached", "reasonCodes"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "representedFileCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "representedJsTsLocators": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/locator" } },
        "skippedFileCount": { "type": "integer", "minimum": 0 },
        "skippedLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "oversizedFileCount": { "type": "integer", "minimum": 0 },
        "oversizedLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "excludedDirectoryCount": { "type": "integer", "minimum": 0 },
        "excludedDirectoryLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "declaredOutOfScopeDirectoryCount": { "type": "integer", "minimum": 0 },
        "declaredOutOfScopeDirectoryLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "sourceRelevantExcludedDirectoryCount": { "type": "integer", "minimum": 0 },
        "sourceRelevantExcludedDirectoryLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "unsupportedFileCount": { "type": "integer", "minimum": 0 },
        "unsupportedExtensions": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^\\.[a-z0-9]{1,16}$" } },
        "unsupportedExtensionCounts": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
        },
        "ignoredFileCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "ignoredDirectoryCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "ignoredSamples": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "ignoreRuleFingerprint": { "$ref": "#/$defs/fingerprint" },
        "ignoreFileLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "candidateNodeCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "representedNodeCount": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "omittedNodeCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "candidateNodeKindCounts": { "$ref": "#/$defs/nodeCountMap" },
        "representedNodeKindCounts": { "$ref": "#/$defs/nodeCountMap" },
        "omittedNodeKindCounts": { "$ref": "#/$defs/nodeCountMap" },
        "candidateEdgeCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "representedEdgeCount": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "omittedEdgeCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "candidateEdgeKindCounts": { "$ref": "#/$defs/edgeCountMap" },
        "representedEdgeKindCounts": { "$ref": "#/$defs/edgeCountMap" },
        "omittedEdgeKindCounts": { "$ref": "#/$defs/edgeCountMap" },
        "maxFilesReached": { "type": "boolean" },
        "reasonCodes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "code"],
      "properties": {
        "locator": { "$ref": "#/$defs/locator" },
        "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_:-]*$" }
      }
    },
    "searchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "workspaceId", "graphFingerprint", "retrievalMethod", "queryFingerprint", "total", "limit", "offset", "hasMore", "omittedCount", "results"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "workspaceId": { "$ref": "#/$defs/workspaceId" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "retrievalMethod": { "const": "source_graph_lexical" },
        "queryFingerprint": { "$ref": "#/$defs/fingerprint" },
        "total": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "hasMore": { "type": "boolean" },
        "omittedCount": { "type": "integer", "minimum": 0 },
        "results": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/searchItem" } }
      }
    },
    "searchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultType", "id", "kind", "label", "score", "reasonCodes"],
      "properties": {
        "resultType": { "enum": ["node", "edge"] },
        "id": { "type": "string", "pattern": "^(sgnode|sgedge)_[a-f0-9]{32}$" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "$ref": "#/$defs/safeLabel" },
        "qualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "locator": { "$ref": "#/$defs/locator" },
        "symbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "scopeChain": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/safeLabel" } },
        "exportName": { "$ref": "#/$defs/safeLabel" },
        "fromNodeId": { "$ref": "#/$defs/nodeId" },
        "fromLabel": { "$ref": "#/$defs/safeLabel" },
        "fromQualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "fromLocator": { "$ref": "#/$defs/locator" },
        "fromKind": { "$ref": "#/$defs/nodeKind" },
        "fromSymbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "toNodeId": { "$ref": "#/$defs/nodeId" },
        "toLabel": { "$ref": "#/$defs/safeLabel" },
        "toQualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "toLocator": { "$ref": "#/$defs/locator" },
        "toKind": { "$ref": "#/$defs/nodeKind" },
        "toSymbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "score": { "type": "number", "minimum": 0 },
        "reasonCodes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "traceResult": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schemaVersion", "workspaceId", "graphFingerprint", "retrievalMethod", "startNodeIds", "direction", "edgeKinds", "depth", "limit", "paths"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "workspaceId": { "$ref": "#/$defs/workspaceId" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "retrievalMethod": { "const": "source_graph_trace" },
        "startNodeIds": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/nodeId" } },
        "direction": { "enum": ["outbound", "inbound", "both"] },
        "edgeKinds": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/edgeKind" } },
        "depth": { "type": "integer", "minimum": 1, "maximum": 5 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "paths": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/tracePath" } }
      }
    },
    "tracePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "nodeIds", "edgeIds", "terminalNodeId", "terminalLabel"],
      "properties": {
        "depth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "nodeIds": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/nodeId" } },
        "edgeIds": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/edgeId" } },
        "edgeKinds": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/edgeKind" } },
        "edgeLocators": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/locator" } },
        "terminalNodeId": { "$ref": "#/$defs/nodeId" },
        "terminalLabel": { "$ref": "#/$defs/safeLabel" },
        "terminalQualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "terminalLocator": { "$ref": "#/$defs/locator" },
        "terminalKind": { "$ref": "#/$defs/nodeKind" },
        "terminalSymbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "terminalScopeChain": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/safeLabel" } }
      }
    },
    "impactResult": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schemaVersion", "workspaceId", "graphFingerprint", "changedLocators", "representedChangedLocators", "depth", "impactedNodeIds", "impactedEdgeIds", "impactedEdgeKindCounts", "affectedSymbols"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "workspaceId": { "$ref": "#/$defs/workspaceId" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "changedLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "representedChangedLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "depth": { "type": "integer", "minimum": 1, "maximum": 5 },
        "impactedNodeIds": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/nodeId" } },
        "impactedEdgeIds": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/edgeId" } },
        "impactedEdgeKindCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "affectedSymbols": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/affectedSymbol" } }
      }
    },
    "affectedSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "name", "locator", "symbolKind"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "name": { "$ref": "#/$defs/safeLabel" },
        "qualifiedName": { "$ref": "#/$defs/safeLabel" },
        "locator": { "$ref": "#/$defs/locator" },
        "symbolKind": { "enum": ["class", "function", "method", "interface", "type"] }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "measurementScope", "fullGraphTokenEstimate", "deliveredTokenEstimate", "omittedTokenEstimate", "reductionPercent", "sourceContentIncluded", "providerBillingClaimed"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "measurementScope": { "const": "full graph nodes/edges/diagnostics versus delivered preview payload" },
        "fullGraphTokenEstimate": { "type": "integer", "minimum": 0 },
        "deliveredTokenEstimate": { "type": "integer", "minimum": 0 },
        "omittedTokenEstimate": { "type": "integer", "minimum": 0 },
        "reductionPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "sourceContentIncluded": { "const": false },
        "providerBillingClaimed": { "const": false }
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dryRun", "persisted", "canonicalStateMutated", "localFilesWritten", "modelCalls", "networkCalls", "externalAdaptersEnabled", "externalWritesEnabled", "graphDatabaseUsed", "rawBodyIncluded", "sourceSlicesRead"],
      "properties": {
        "dryRun": { "const": true },
        "persisted": { "const": false },
        "canonicalStateMutated": { "const": false },
        "localFilesWritten": { "const": 0 },
        "modelCalls": { "const": 0 },
        "networkCalls": { "const": 0 },
        "externalAdaptersEnabled": { "const": 0 },
        "externalWritesEnabled": { "const": false },
        "graphDatabaseUsed": { "const": false },
        "rawBodyIncluded": { "const": false },
        "sourceSlicesRead": { "const": false }
      }
    }
  }
}
