{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/memory-record-1.0.json",
  "title": "Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "workspaceId",
    "kind",
    "text",
    "status",
    "source",
    "confidence",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^mem_"
    },
    "workspaceId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "fact",
        "preference",
        "decision",
        "episode",
        "procedure",
        "constraint"
      ]
    },
    "text": {
      "type": "string"
    },
    "status": {
      "enum": [
        "observed",
        "proposed",
        "verified",
        "active",
        "rejected",
        "superseded",
        "retracted",
        "expired",
        "quarantined"
      ]
    },
    "source": {
      "type": "string"
    },
    "sourceTrust": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "propose",
        "review",
        "allow",
        "reject"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "validTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "retention": {
      "type": "string"
    },
    "dataClass": {
      "enum": [
        "public",
        "workspace-private",
        "sensitive",
        "secret"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verifiedBy": {
      "type": "string"
    },
    "activatedBy": {
      "type": "string"
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleEvent"
      }
    }
  },
  "$defs": {
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "actorId",
        "reason",
        "evidenceIds"
      ],
      "properties": {
        "type": {
          "enum": [
            "memory.proposed",
            "memory.verified",
            "memory.activated",
            "memory.rejected",
            "memory.superseded",
            "memory.retracted",
            "memory.expired"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actorId": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
