{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/memory-temporal-fact-1.0.json",
  "title": "Temporal Memory Fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "workspaceId",
    "scope",
    "subject",
    "predicate",
    "object",
    "text",
    "status",
    "source",
    "confidence",
    "validFrom",
    "validUntil",
    "supersededBy",
    "episodeId",
    "proposalQueueId",
    "createdAt",
    "updatedAt",
    "metadata",
    "episode"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^memfact_[A-Za-z0-9._-]{1,128}$"
    },
    "workspaceId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "scope": { "enum": ["workspace", "session", "agent", "user"] },
    "subject": { "type": "string", "minLength": 1, "maxLength": 512 },
    "predicate": { "type": "string", "minLength": 1, "maxLength": 256 },
    "object": { "type": "string", "minLength": 1, "maxLength": 1000000 },
    "text": { "type": "string", "minLength": 1, "maxLength": 1000000 },
    "status": { "enum": ["active", "superseded"] },
    "source": {
      "type": "string",
      "pattern": "^workspace://[A-Za-z0-9._~!$&'()*+,;=:@%/-]{1,512}$"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": ["string", "null"], "format": "date-time" },
    "supersededBy": { "type": ["string", "null"] },
    "episodeId": {
      "type": "string",
      "pattern": "^mep_[A-Za-z0-9._-]{1,128}$"
    },
    "proposalQueueId": {
      "type": "string",
      "pattern": "^mpq_[A-Za-z0-9._-]{1,128}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" },
    "episode": { "$ref": "#/$defs/episode" }
  },
  "$defs": {
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "workspaceId",
        "scope",
        "sourceLocator",
        "summary",
        "observedAt",
        "createdAt",
        "metadata"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": {
          "type": "string",
          "pattern": "^mep_[A-Za-z0-9._-]{1,128}$"
        },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "scope": { "enum": ["workspace", "session", "agent", "user"] },
        "sourceLocator": {
          "type": "string",
          "pattern": "^workspace://[A-Za-z0-9._~!$&'()*+,;=:@%/-]{1,512}$"
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "observedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    }
  }
}
