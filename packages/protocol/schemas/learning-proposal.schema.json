{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/learning-proposal.schema.json",
  "title": "Learning Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "workspaceId",
    "status",
    "observedFailure",
    "evidenceIds",
    "proposedChange",
    "expectedBenefit",
    "affectedComponents",
    "regressionTests",
    "rollout",
    "rollback",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^learn_" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "evaluating", "approved", "rejected", "rolled-back"] },
    "observedFailure": { "type": "string", "minLength": 1 },
    "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "proposedChange": { "type": "object", "minProperties": 1 },
    "expectedBenefit": { "type": "string", "minLength": 1 },
    "affectedComponents": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "regressionTests": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "rollout": { "type": "string", "minLength": 1 },
    "rollback": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
