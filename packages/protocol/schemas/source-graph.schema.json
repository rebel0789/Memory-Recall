{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/source-graph.schema.json",
  "title": "Native Source Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "graphVersion", "parserVersion", "builtAt", "sourceIndexFingerprint", "summary", "nodes", "edges", "diagnostics", "graphFingerprint"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$" },
    "graphVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "parserVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "builtAt": { "type": "string", "format": "date-time" },
    "sourceIndexFingerprint": { "$ref": "#/$defs/fingerprint" },
    "summary": { "$ref": "#/$defs/summary" },
    "nodes": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/$defs/edge" } },
    "diagnostics": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/diagnostic" } },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nodeId": { "type": "string", "pattern": "^sgnode_[a-f0-9]{32}$" },
    "edgeId": { "type": "string", "pattern": "^sgedge_[a-f0-9]{32}$" },
    "locator": { "type": "string", "pattern": "^workspace://(?!/)(?![^/]*%)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!.*%(?:2[eEfF]|3[aA]|5[cC]|25))[A-Za-z0-9._~!$&'()*+,;=@%/\\[\\]-]{1,512}(?:#L[0-9]+-L[0-9]+)?$" },
    "safeLabel": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?=.{1,240}$)(?!/)(?![A-Za-z]:[\\\\/])(?!.*[?{}=;\\\\])(?!.*[Ss][Ee][Nn][Tt][Ii][Nn][Ee][Ll])(?:[A-Za-z0-9_$@~./#*+,\\[\\]-]+|node:[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*|local:absolute-import)(?: (?:contains|defined_in|imports|exports|references|calls)(?: (?:[A-Za-z0-9_$@~./#*+,\\[\\]-]+|node:[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*|local:absolute-import)){1,2})?$" },
    "sourceRef": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(symbol|astchunk|import|export|call|ref|srcsnap)_[a-f0-9]{16,32}$|^sha256:[a-f0-9]{64}$" },
    "nodeCountMap": {
      "type": "object",
      "maxProperties": 4,
      "additionalProperties": false,
      "properties": {
        "file": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "chunk": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "symbol": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "module": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "edgeCountMap": {
      "type": "object",
      "maxProperties": 6,
      "additionalProperties": false,
      "properties": {
        "contains": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "defined_in": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "imports": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "exports": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "calls": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "references": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "symbolCount", "moduleCount", "nodeCount", "edgeCount", "nodeKindCounts", "edgeKindCounts", "hotspots", "entryPoints"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 0 },
        "symbolCount": { "type": "integer", "minimum": 0 },
        "moduleCount": { "type": "integer", "minimum": 0 },
        "nodeCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "qualifiedSymbolCount": { "type": "integer", "minimum": 0 },
        "ambiguousSymbolLabelCount": { "type": "integer", "minimum": 0 },
        "ambiguousLabels": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/ambiguousLabel" } },
        "nodeKindCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "edgeKindCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "hotspots": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/hotspot" } },
        "entryPoints": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/nodeReference" } },
        "deprioritized": { "type": "array", "maxItems": 25, "items": { "$ref": "#/$defs/nodeReference" } }
      }
    },
    "ambiguousLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "count", "locators"],
      "properties": {
        "label": { "$ref": "#/$defs/safeLabel" },
        "count": { "type": "integer", "minimum": 2 },
        "qualifiedLabels": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/safeLabel" } },
        "locators": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/locator" } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$" },
        "kind": { "enum": ["file", "chunk", "symbol", "module"] },
        "label": { "$ref": "#/$defs/safeLabel" },
        "qualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "locator": { "$ref": "#/$defs/locator" },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "symbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "scopeChain": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/safeLabel" } },
        "moduleHash": { "$ref": "#/$defs/fingerprint" },
        "contentHash": { "$ref": "#/$defs/fingerprint" },
        "sourceSnapshotId": { "type": "string", "pattern": "^srcsnap_[a-f0-9]{16}$" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "kind", "fromNodeId", "toNodeId", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/edgeId" },
        "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,127}$" },
        "kind": { "enum": ["contains", "defined_in", "imports", "exports", "references", "calls"] },
        "fromNodeId": { "$ref": "#/$defs/nodeId" },
        "toNodeId": { "$ref": "#/$defs/nodeId" },
        "locator": { "$ref": "#/$defs/locator" },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "exportName": { "$ref": "#/$defs/safeLabel" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "inbound", "outbound", "total"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "label": { "$ref": "#/$defs/safeLabel" },
        "qualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "locator": { "$ref": "#/$defs/locator" },
        "symbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "inbound": { "type": "integer", "minimum": 0 },
        "outbound": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "reasonCodes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "nodeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "locator", "symbolKind"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "label": { "$ref": "#/$defs/safeLabel" },
        "qualifiedLabel": { "$ref": "#/$defs/safeLabel" },
        "locator": { "$ref": "#/$defs/locator" },
        "symbolKind": { "enum": ["class", "function", "method", "interface", "type"] },
        "reasonCodes": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "representedFileCount", "representedJsTsLocators", "skippedFileCount", "skippedLocators", "oversizedFileCount", "oversizedLocators", "unsupportedFileCount", "unsupportedExtensions", "maxFilesReached", "reasonCodes"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "representedFileCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "representedJsTsLocators": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/locator" } },
        "skippedFileCount": { "type": "integer", "minimum": 0 },
        "skippedLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "oversizedFileCount": { "type": "integer", "minimum": 0 },
        "oversizedLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "excludedDirectoryCount": { "type": "integer", "minimum": 0 },
        "excludedDirectoryLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "declaredOutOfScopeDirectoryCount": { "type": "integer", "minimum": 0 },
        "declaredOutOfScopeDirectoryLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "sourceRelevantExcludedDirectoryCount": { "type": "integer", "minimum": 0 },
        "sourceRelevantExcludedDirectoryLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "unsupportedFileCount": { "type": "integer", "minimum": 0 },
        "unsupportedExtensions": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^\\.[a-z0-9]{1,16}$" } },
        "unsupportedExtensionCounts": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
        },
        "ignoredFileCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "ignoredDirectoryCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "ignoredSamples": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "ignoreRuleFingerprint": { "$ref": "#/$defs/fingerprint" },
        "ignoreFileLocators": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/locator" } },
        "candidateNodeCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "representedNodeCount": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "omittedNodeCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "candidateNodeKindCounts": { "$ref": "#/$defs/nodeCountMap" },
        "representedNodeKindCounts": { "$ref": "#/$defs/nodeCountMap" },
        "omittedNodeKindCounts": { "$ref": "#/$defs/nodeCountMap" },
        "candidateEdgeCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "representedEdgeCount": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "omittedEdgeCount": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "candidateEdgeKindCounts": { "$ref": "#/$defs/edgeCountMap" },
        "representedEdgeKindCounts": { "$ref": "#/$defs/edgeCountMap" },
        "omittedEdgeKindCounts": { "$ref": "#/$defs/edgeCountMap" },
        "maxFilesReached": { "type": "boolean" },
        "reasonCodes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "code"],
      "properties": {
        "locator": { "$ref": "#/$defs/locator" },
        "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_:-]*$" }
      }
    }
  }
}
