{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/candidate-source-descriptor-1.0.json",
  "title": "Candidate Source Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "version", "enabled", "methods"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^provider:native:context-candidate:[a-z0-9-]+$" },
    "kind": { "$ref": "#/$defs/kind" },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "enabled": { "type": "boolean" },
    "methods": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "contractVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "description": { "type": "string", "maxLength": 512 }
  },
  "$defs": {
    "kind": {
      "enum": ["exact", "lexical", "vector", "graph", "temporal", "preference", "episode"]
    }
  }
}
