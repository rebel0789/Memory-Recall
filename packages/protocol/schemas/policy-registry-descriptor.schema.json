{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/policy-registry-descriptor.schema.json",
  "title": "Policy Registry Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "fingerprint", "knownActions", "resourceTypes", "dataClasses", "sideEffectClasses", "externalWritesEnabled"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "knownActions": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 96 } },
    "resourceTypes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "dataClasses": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["public", "workspace-private", "confidential", "secret"] } },
    "sideEffectClasses": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["read-only", "reversible-write", "consequential-write"] } },
    "externalWritesEnabled": { "const": false }
  }
}
