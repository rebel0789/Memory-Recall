{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/retention-policy-1.0.json",
  "title": "Artifact Retention Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode"],
  "properties": {
    "mode": {
      "enum": ["workspace-default", "retain", "expire-at", "legal-hold"]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
