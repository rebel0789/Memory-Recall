{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Load Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "generatedAt",
    "workspaceId",
    "rootRef",
    "skill",
    "requiredLocalReads",
    "catalogFingerprint",
    "safeguards",
    "loadPlanFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "command": { "const": "skill load-plan" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "workspaceId": { "type": "string" },
    "rootRef": { "const": "workspace://." },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "version",
        "advertised",
        "directoryRef",
        "manifestRef",
        "skillRef",
        "sideEffectClass",
        "triggers",
        "tools",
        "references",
        "readiness",
        "manifestFingerprint",
        "checks"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "version": { "type": "string" },
        "advertised": { "type": "boolean" },
        "directoryRef": { "type": "string", "pattern": "^workspace://skills/[^/]+$" },
        "manifestRef": { "type": "string", "pattern": "^workspace://skills/[^/]+/manifest\\.json$" },
        "skillRef": { "type": "string", "pattern": "^workspace://skills/[^/]+/SKILL\\.md$" },
        "sideEffectClass": { "enum": ["read-only", "reversible-write", "consequential-write"] },
        "triggers": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "references": {
          "type": "array",
          "items": { "type": "string", "pattern": "^workspace://skills/[^/]+/.+" }
        },
        "readiness": { "$ref": "#/$defs/readiness" },
        "manifestFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifestValid", "skillDocumentPresent", "referencesPresent"],
          "properties": {
            "manifestValid": { "const": true },
            "skillDocumentPresent": { "const": true },
            "referencesPresent": { "const": true }
          }
        }
      }
    },
    "requiredLocalReads": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "kind", "ref", "reason"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["manifest", "skill", "reference"] },
          "ref": { "type": "string", "pattern": "^workspace://skills/[^/]+/.+" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "catalogFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "canonicalStateMutated",
        "localFilesWritten",
        "externalWritesEnabled",
        "networkCalls",
        "modelCalls",
        "rawSkillTextIncluded",
        "toolAuthorityGranted",
        "absoluteFilesystemLocationsIncluded"
      ],
      "properties": {
        "readOnly": { "const": true },
        "canonicalStateMutated": { "const": false },
        "localFilesWritten": { "const": 0 },
        "externalWritesEnabled": { "const": false },
        "networkCalls": { "const": 0 },
        "modelCalls": { "const": 0 },
        "rawSkillTextIncluded": { "const": false },
        "toolAuthorityGranted": { "const": false },
        "absoluteFilesystemLocationsIncluded": { "const": false }
      }
    },
    "loadPlanFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approvalRequired", "unreviewedToolIds", "reasonCodes"],
      "properties": {
        "state": { "enum": ["ready", "review", "blocked"] },
        "approvalRequired": { "type": "boolean" },
        "unreviewedToolIds": { "type": "array", "items": { "type": "string" } },
        "disabledToolIds": { "type": "array", "items": { "type": "string" } },
        "reasonCodes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
