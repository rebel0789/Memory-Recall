{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/mcp-bridge-request.schema.json",
  "title": "OAF MCP Bridge Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "method"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["string", "integer"] },
    "method": {
      "enum": [
        "initialize",
        "ping",
        "tools/list",
        "tools/call",
        "resources/list",
        "resources/read"
      ]
    },
    "params": { "type": "object" }
  }
}
