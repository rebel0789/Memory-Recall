{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/candidate-source-hit-1.0.json",
  "title": "Candidate Source Hit",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceId", "sourceKind", "sourceVersion", "retrievalMethod", "localRank", "localScore", "reasonCodes", "queryFingerprint", "accessDecisionRef", "retrievedAt"],
  "properties": {
    "sourceId": { "type": "string", "pattern": "^provider:native:context-candidate:[a-z0-9-]+$" },
    "sourceKind": { "enum": ["exact", "lexical", "ast-code", "vector", "graph", "temporal", "preference", "episode"] },
    "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "retrievalMethod": { "type": "string", "minLength": 1, "maxLength": 64 },
    "localRank": { "type": "integer", "minimum": 1 },
    "localScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasonCodes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]*$" },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "queryFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "accessDecisionRef": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "retrievedAt": { "type": "string", "format": "date-time" }
  }
}
