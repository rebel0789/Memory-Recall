{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/model-generation-request.schema.json",
  "title": "Safe Model Generation Request Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gatewayVersion",
    "requestId",
    "correlationId",
    "workspaceId",
    "provider",
    "model",
    "promptFingerprint",
    "outputSchemaFingerprint",
    "prompt",
    "outputSchema",
    "contextManifest",
    "timeoutMs",
    "repair"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "gatewayVersion": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "pattern": "^provider:native:model:[a-z0-9-]+$" },
    "model": { "type": "string", "minLength": 1 },
    "promptFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outputSchemaFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fingerprint", "assemblyVersion", "byteLength"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "assemblyVersion": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "fingerprint"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "contextManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifestFingerprint",
        "assemblyFingerprint",
        "compilerVersion",
        "assemblyPolicyVersion",
        "assemblyPolicyFingerprint",
        "selectedCount",
        "excludedCount"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ctx_" },
        "manifestFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "assemblyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "compilerVersion": { "type": "string", "minLength": 1 },
        "assemblyPolicyVersion": { "type": "string", "minLength": 1 },
        "assemblyPolicyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "selectedCount": { "type": "integer", "minimum": 0 },
        "excludedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "timeoutMs": { "type": "integer", "minimum": 1 },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "occurredAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
