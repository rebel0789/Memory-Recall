{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/benchmark-comparison-report.schema.json",
  "title": "Benchmark Truth-Floor Comparison Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "suite", "dataset", "subject", "commitSha", "runner", "generatedAt", "thresholds", "metrics", "baselines", "cases", "counts", "gateDecision", "safeguards", "phaseArtifacts", "labVersion", "reportFingerprint"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^evalrep_[A-Za-z0-9._:-]+$" },
    "suite": { "const": "benchmark-truth-floor" },
    "dataset": { "$ref": "#/$defs/datasetRef" },
    "subject": { "$ref": "#/$defs/subject" },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "runner": { "$ref": "#/$defs/runner" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "baselines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/baselineSummary" } },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/caseSummary" } },
    "counts": { "$ref": "#/$defs/counts" },
    "gateDecision": { "enum": ["pass", "fail"] },
    "safeguards": { "$ref": "#/$defs/safeguards" },
    "phaseArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/phaseArtifactSummary" } },
    "labVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "reportFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "datasetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "datasetFingerprint", "caseCount"],
      "properties": {
        "id": { "type": "string", "pattern": "^evalds_[A-Za-z0-9._:-]+$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "datasetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "caseCount": { "type": "integer", "minimum": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "fingerprint"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEvidenceRecall", "distractorExclusionRate", "selectedTokenRatioMax", "deterministicMismatchCount"],
      "properties": {
        "requiredEvidenceRecall": { "type": "number", "minimum": 0, "maximum": 1 },
        "distractorExclusionRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "selectedTokenRatioMax": { "type": "number", "minimum": 0, "maximum": 1 },
        "deterministicMismatchCount": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEvidenceRecall", "distractorExclusionRate", "selectedTokenRatio", "secretLeakageCount", "localPathLeakageCount", "rawPromptLeakageCount", "rawContextLeakageCount", "rawOutputLeakageCount", "forbiddenInclusionCount", "workspaceLeakageCount", "deterministicMismatchCount", "durationMs", "recallAt10", "mrrAt10", "ndcgAt10"],
      "properties": {
        "requiredEvidenceRecall": { "type": "number", "minimum": 0, "maximum": 1 },
        "distractorExclusionRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "selectedTokenRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "secretLeakageCount": { "type": "integer", "minimum": 0 },
        "localPathLeakageCount": { "type": "integer", "minimum": 0 },
        "rawPromptLeakageCount": { "type": "integer", "minimum": 0 },
        "rawContextLeakageCount": { "type": "integer", "minimum": 0 },
        "rawOutputLeakageCount": { "type": "integer", "minimum": 0 },
        "forbiddenInclusionCount": { "type": "integer", "minimum": 0 },
        "workspaceLeakageCount": { "type": "integer", "minimum": 0 },
        "deterministicMismatchCount": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "recallAt10": { "type": "number", "minimum": 0, "maximum": 1 },
        "mrrAt10": { "type": "number", "minimum": 0, "maximum": 1 },
        "ndcgAt10": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "baselineSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "caseCount", "metrics", "resultFingerprint"],
      "properties": {
        "name": { "enum": ["exact", "full", "lexical", "current-harness"] },
        "status": { "enum": ["passed", "failed"] },
        "caseCount": { "type": "integer", "minimum": 1 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "resultFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "caseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "status", "requiredEvidenceCount", "distractorCount", "forbiddenCount", "baselines", "metrics", "caseFingerprint"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^evalcase_[A-Za-z0-9._:-]+$" },
        "status": { "enum": ["passed", "failed"] },
        "requiredEvidenceCount": { "type": "integer", "minimum": 0 },
        "distractorCount": { "type": "integer", "minimum": 0 },
        "forbiddenCount": { "type": "integer", "minimum": 0 },
        "baselines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/caseBaseline" } },
        "metrics": { "$ref": "#/$defs/metrics" },
        "caseFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "caseBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "caseId", "status", "selectedEvidenceIds", "excludedEvidenceIds", "selectedLocatorIds", "metrics", "resultFingerprint"],
      "properties": {
        "name": { "enum": ["exact", "full", "lexical", "current-harness"] },
        "caseId": { "type": "string", "pattern": "^evalcase_[A-Za-z0-9._:-]+$" },
        "status": { "enum": ["passed", "failed"] },
        "selectedEvidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" }, "uniqueItems": true },
        "excludedEvidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" }, "uniqueItems": true },
        "selectedLocatorIds": { "type": "array", "items": { "type": "string", "pattern": "^workspace://[^\\s]+$" }, "uniqueItems": true },
        "errorCode": { "type": "string", "minLength": 1, "maxLength": 120 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "resultFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "caseCount", "baselineCount"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "caseCount": { "type": "integer", "minimum": 1 },
        "baselineCount": { "type": "integer", "minimum": 1 }
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawPromptsIncluded", "rawContextIncluded", "rawOutputsIncluded", "rawPathsIncluded", "secretsIncluded", "modelCalls", "networkCalls", "activeMemoryCreated", "sourceSnapshotsWritten", "externalAdaptersEnabled", "externalWritesEnabled", "leakageCounts"],
      "properties": {
        "rawPromptsIncluded": { "const": false },
        "rawContextIncluded": { "const": false },
        "rawOutputsIncluded": { "const": false },
        "rawPathsIncluded": { "const": false },
        "secretsIncluded": { "const": false },
        "modelCalls": { "const": 0 },
        "networkCalls": { "const": 0 },
        "activeMemoryCreated": { "const": 0 },
        "sourceSnapshotsWritten": { "const": 0 },
        "externalAdaptersEnabled": { "const": 0 },
        "externalWritesEnabled": { "const": false },
        "leakageCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secret", "localPath", "rawPrompt", "rawContext", "rawOutput", "forbiddenInclusion", "workspace"],
          "properties": {
            "secret": { "type": "integer", "minimum": 0 },
            "localPath": { "type": "integer", "minimum": 0 },
            "rawPrompt": { "type": "integer", "minimum": 0 },
            "rawContext": { "type": "integer", "minimum": 0 },
            "rawOutput": { "type": "integer", "minimum": 0 },
            "forbiddenInclusion": { "type": "integer", "minimum": 0 },
            "workspace": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "phaseArtifactSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "suite", "phase", "dataset", "generatedAt", "baselineNames", "caseCount", "metrics", "artifactFingerprint"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": { "type": "string", "pattern": "^evalphase_[A-Za-z0-9._:-]+$" },
        "suite": { "const": "benchmark-truth-floor" },
        "phase": { "enum": ["retrieval", "assembly", "comparison"] },
        "dataset": { "$ref": "#/$defs/datasetRef" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "baselineNames": { "type": "array", "minItems": 1, "items": { "enum": ["exact", "full", "lexical", "current-harness"] }, "uniqueItems": true },
        "caseCount": { "type": "integer", "minimum": 1 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "artifactFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
