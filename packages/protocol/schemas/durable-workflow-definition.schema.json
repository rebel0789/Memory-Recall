{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/durable-workflow-definition-1.0.json",
  "title": "Durable Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "fingerprint", "name", "description", "steps"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^workflow:[a-z0-9_.:-]{1,96}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^handler:[a-z0-9_.:-]{1,96}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "timeoutMs", "retry", "approval", "idempotency", "riskClass", "inputSchema", "outputSchema"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "kind": { "enum": ["deterministic", "model", "activity", "timer", "approval"] },
        "handler": { "$ref": "#/$defs/handler" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
            "initialDelayMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
            "maxDelayMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
          }
        },
        "timer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delayMs"],
          "properties": {
            "delayMs": { "type": "integer", "minimum": 1, "maximum": 86400000 }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "operationFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9-]{1,128}$" },
            "expiresInMs": { "type": "integer", "minimum": 1, "maximum": 86400000 }
          }
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "operationFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9-]{1,128}$" }
          }
        },
        "riskClass": { "enum": ["read-only", "reversible-write", "consequential-write"] },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "compensation": { "type": ["object", "null"] }
      }
    }
  }
}
