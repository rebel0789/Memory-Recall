{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-fabric.dev/schemas/reviewed-tool-manifest-1.1.json",
  "title": "Reviewed Tool Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "id", "name", "version", "handlerBindingId", "operations"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^tool:[a-z0-9_.:-]{1,120}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "handlerBindingId": { "type": "string", "pattern": "^handler:" },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sideEffectClass", "inputSchema", "outputSchema", "filesystem", "network", "secretReferences", "dataClasses", "sandbox", "limits", "approval", "idempotency"],
      "properties": {
        "sideEffectClass": { "enum": ["read-only", "reversible-write", "consequential-write"] },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^workspace:" } },
            "write": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^workspace:" } }
          }
        },
        "network": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/networkDestination" }
        },
        "secretReferences": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^secret:[A-Za-z0-9_.:-]{1,120}$" }
        },
        "dataClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "enum": ["public", "workspace-private", "confidential", "secret"] }
        },
        "sandbox": { "$ref": "#/$defs/sandboxProfile" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtimeMs", "inputBytes", "outputBytes", "costUnits"],
          "properties": {
            "runtimeMs": { "type": "integer", "minimum": 1 },
            "inputBytes": { "type": "integer", "minimum": 1 },
            "outputBytes": { "type": "integer", "minimum": 1 },
            "memoryBytes": { "type": "integer", "minimum": 0 },
            "invocationCount": { "type": "integer", "minimum": 0 },
            "costUnits": { "type": "integer", "minimum": 0 },
            "retryCount": { "type": "integer", "minimum": 0 }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": { "required": { "type": "boolean" } }
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": { "required": { "type": "boolean" } }
        }
      }
    },
    "networkDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "host", "port", "methods", "consequence", "locality"],
      "properties": {
        "protocol": { "enum": ["http", "https"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 255 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "methods": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["GET", "HEAD"] } },
        "consequence": { "enum": ["read", "write"] },
        "locality": { "enum": ["loopback", "external"] }
      }
    },
    "sandboxProfile": {
      "enum": ["pure-local", "brokered-filesystem-read", "brokered-filesystem-write", "brokered-loopback-http", "brokered-secret-reference"]
    }
  }
}
