{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/candidate-source-request-1.0.json",
  "title": "Candidate Source Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "correlationId",
    "workspaceId",
    "actorId",
    "taskId",
    "step",
    "objective",
    "requiredIds",
    "requiredEntities",
    "allowedDataClasses",
    "allowedTrustClasses",
    "sourcePlan",
    "perSourceLimit",
    "totalCandidateLimit",
    "trustedTimestamp"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requestId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 128 },
    "correlationId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 128 },
    "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 128 },
    "actorId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 128 },
    "taskId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 128 },
    "step": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "requiredIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" },
      "maxItems": 128,
      "uniqueItems": true
    },
    "requiredEntities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 256 },
      "maxItems": 128,
      "uniqueItems": true
    },
    "allowedDataClasses": {
      "type": "array",
      "items": { "enum": ["public", "workspace-private", "confidential", "secret"] },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "allowedTrustClasses": {
      "type": "array",
      "items": { "enum": ["verified", "trusted", "observed", "untrusted"] },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "sourcePlan": { "$ref": "#/$defs/sourcePlan" },
    "perSourceLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "totalCandidateLimit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "trustedTimestamp": { "type": "string", "format": "date-time" },
    "tokenBudget": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sourcePlan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "required"],
        "properties": {
          "kind": {
            "enum": ["exact", "lexical", "vector", "graph", "temporal", "preference", "episode"]
          },
          "sourceId": {
            "type": ["string", "null"],
            "pattern": "^provider:native:context-candidate:[a-z0-9-]+$"
          },
          "required": { "type": "boolean" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 }
        }
      }
    }
  }
}
