{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfabric.dev/schemas/candidate-identity-conflict-1.0.json",
  "title": "Candidate Identity Conflict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "failureCode", "recordId", "sourceIds"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "failureCode": { "const": "candidate_identity_conflict" },
    "recordId": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$" },
    "sourceIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^provider:native:context-candidate:[a-z0-9-]+$" },
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true
    }
  }
}
