{
  "schemaVersion": "1.0.0",
  "providers": [
    {
      "id": "provider:native:memory:sqlite",
      "path": "providers/native/memory-sqlite",
      "enabledByDefault": true,
      "purpose": "Workspace-scoped temporal memory and FTS5 candidate search"
    },
    {
      "id": "provider:native:artifact:filesystem",
      "path": "providers/native/artifact-filesystem",
      "enabledByDefault": true,
      "purpose": "Content-addressed local artifacts and source snapshots"
    },
    {
      "id": "provider:native:workflow:embedded",
      "path": "providers/native/workflow-embedded",
      "enabledByDefault": true,
      "purpose": "Bounded local execution with event checkpoints"
    },
    {
      "id": "provider:native:workflow:durable-sqlite",
      "path": "providers/native/workflow-durable-sqlite",
      "enabledByDefault": false,
      "purpose": "Dependency-free local SQLite durable workflow recovery baseline"
    },
    {
      "id": "provider:native:model:deterministic",
      "path": "providers/native/model-deterministic",
      "enabledByDefault": true,
      "purpose": "Offline deterministic demo and regression output"
    },
    {
      "id": "provider:native:identity:local",
      "path": "providers/native/identity-local",
      "enabledByDefault": true,
      "purpose": "Local-first users, sessions, API tokens, workspace memberships, and security audit"
    },
    {
      "id": "provider:native:policy:deterministic",
      "path": "providers/native/policy-deterministic",
      "enabledByDefault": true,
      "purpose": "Deterministic contextual policy decisions for resources, tools, data classes, risk, approvals, and budgets"
    },
    {
      "id": "provider:native:context-candidate:exact",
      "path": "providers/native/context-candidate-exact",
      "enabledByDefault": true,
      "purpose": "Workspace-scoped exact context candidate lookup by canonical record id"
    },
    {
      "id": "provider:native:context-candidate:lexical",
      "path": "providers/native/context-candidate-lexical",
      "enabledByDefault": true,
      "purpose": "Deterministic lexical context candidate lookup over safe record fields"
    },
    {
      "id": "provider:native:context-manifest:local",
      "path": "providers/native/context-manifest-local",
      "enabledByDefault": true,
      "purpose": "Workspace-scoped immutable local context manifest persistence"
    },
    {
      "id": "provider:native:model:ollama",
      "path": "providers/native/model-ollama",
      "enabledByDefault": false,
      "purpose": "Explicit loopback-only local model generation"
    }
  ]
}
