{
  "schemaVersion": "1.0.0",
  "id": "provider:native:tool:brokered-local",
  "name": "Native brokered local tool executor",
  "version": "0.1.0",
  "category": "tool",
  "enabledByDefault": true,
  "locality": "in-process",
  "contract": "ToolExecutionPort",
  "contractVersion": "1.0.0",
  "capabilities": [
    "tool.reviewed-catalog",
    "tool.one-use-grants",
    "tool.brokered-filesystem",
    "tool.loopback-egress",
    "tool.secret-references",
    "tool.idempotent-local-writes"
  ],
  "limits": {
    "runtimeMs": 30000,
    "inputBytes": 65536,
    "outputBytes": 65536,
    "network": "loopback-only",
    "externalWrites": false
  },
  "dataPaths": [
    ".local/tool-grants"
  ],
  "experimental": false,
  "notes": [
    "Process-local grants are not durable and are invalidated on restart.",
    "Reviewed built-in handlers only; no arbitrary shell, downloaded code, or public internet egress."
  ]
}
