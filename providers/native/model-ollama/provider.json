{
  "schemaVersion": "1.0.0",
  "id": "provider:native:model:ollama",
  "name": "Native Ollama Model Provider",
  "version": "0.2.0-dev",
  "category": "model",
  "enabledByDefault": false,
  "locality": "loopback-process",
  "contract": "ModelGatewayPort",
  "contractVersion": "1.0.0",
  "capabilities": [
    "model.generate.text",
    "model.structured-output",
    "model.local-loopback",
    "model.safe-events",
    "model.bounded-repair"
  ],
  "limits": {
    "defaultTimeoutMs": 120000,
    "baseUrlPolicy": "loopback HTTP only unless explicitly overridden",
    "silentFallback": false,
    "requiresPersistedContextManifest": true,
    "maxRepairAttempts": 1,
    "recordsRawPromptOrOutput": false
  },
  "dataPaths": [],
  "experimental": true,
  "notes": [
    "Requires a separately installed Ollama server and an explicitly selected local model.",
    "Never falls back to a cloud provider."
  ]
}
