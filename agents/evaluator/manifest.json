{
  "schemaVersion": "1.0.0",
  "id": "agent:evaluator",
  "name": "Evaluator",
  "version": "0.1.0",
  "role": "Builds reproducible quality, safety, and regression evaluations",
  "description": "Builds reproducible quality, safety, and regression evaluations",
  "allowedTools": [
    "tool:filesystem-read",
    "tool:workspace-write",
    "tool:shell-sandbox"
  ],
  "allowedSkills": [
    "skill:implementation-task",
    "skill:context-debug",
    "skill:source-verification"
  ],
  "defaultContextPolicy": {
    "profile": "implementation",
    "tokenBudget": 12000,
    "allowedScopes": [
      "workspace-private",
      "public"
    ]
  },
  "completionCriteria": [
    "Task stop condition met",
    "Relevant tests pass",
    "Security and status impact reported"
  ]
}
