{
  "name": "open-agent-fabric",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "description": "Local-first, evidence-first infrastructure for inspectable AI agents.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "providers/native/*",
    "services/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node services/control-api/src/server.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "eval": "node scripts/run-evals.mjs",
    "eval:context-recall": "node scripts/context-recall-eval.mjs --dataset evals/context-recall/oaf-repo-gold.v1.json --mode compiler-code-search",
    "check": "node scripts/check.mjs",
    "ci": "npm run check && npm run protocol:validate && npm test && npm run eval",
    "doctor": "node scripts/doctor.mjs",
    "auth:bootstrap": "node scripts/auth-bootstrap.mjs",
    "db:status": "node scripts/db.mjs status --migrations deploy/postgres/migrations",
    "db:migrate": "node scripts/db.mjs migrate --migrations deploy/postgres/migrations",
    "db:test:postgres": "node scripts/postgres-recovery-test.mjs",
    "manifest": "node scripts/generate-manifest.mjs",
    "status": "node scripts/status.mjs",
    "task": "node scripts/task.mjs",
    "oaf": "node apps/cli/oaf.mjs",
    "native:smoke": "node scripts/native-smoke.mjs",
    "ops:smoke": "node scripts/operations-smoke.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:readiness:check": "node scripts/release-readiness-check.mjs",
    "tool:bounded:smoke": "node scripts/tool-bounded-smoke.mjs",
    "workflow:durable:smoke": "node scripts/workflow-durable-smoke.mjs",
    "workflow:worker": "node scripts/workflow-worker.mjs",
    "workflow:inspect": "node scripts/workflow-inspect.mjs",
    "verify:handoff": "node scripts/verify-handoff.mjs",
    "protocol:validate": "node scripts/validate-protocol.mjs"
  },
  "license": "Apache-2.0",
  "bin": {
    "oaf": "apps/cli/oaf.mjs"
  }
}
