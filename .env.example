# Local bootstrap. No secret is required.
OAF_HOST=127.0.0.1
OAF_PORT=4310
OAF_DATA_DIR=.local
OAF_MODEL_MODE=deterministic
OAF_ALLOW_NETWORK=false
OAF_ALLOW_EXTERNAL_WRITES=false

# Native local data providers.
OAF_MEMORY_PROVIDER=provider:native:memory:sqlite
OAF_MEMORY_PATH=.local/memory.sqlite
OAF_ARTIFACT_PROVIDER=provider:native:artifact:filesystem
OAF_ARTIFACT_ROOT=.local/artifacts

# Optional explicit loopback Ollama provider. It is disabled unless selected by
# application composition and never falls back to cloud.
OAF_OLLAMA_BASE_URL=http://127.0.0.1:11434
OAF_OLLAMA_MODEL=
